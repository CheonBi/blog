{
  "name": "cheonbi-blog",
  "version": "1.0.0",
  "private": true,
  "description": "cheonbi-blog with monorepo structure",
  "repository": {
    "url": "https://github.com/CheonBi/blog",
    "type": "git"
  },
  "license": "MIT",
  "author": "cheonbi <root@cheonbi.kr>",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev:kineto": "pnpm --filter kineto dev",
    "build": "pnpm -r build",
    "build:blog": "pnpm --filter blog build",
    "build:kineto": "pnpm --filter kineto build",
    "lint": "oxlint --type-aware && node apps/blog/scripts/check-markdown.mjs --quiet",
    "lint:fix": "oxlint --type-aware --fix",
    "prettier": "oxfmt --check .",
    "prettier:fix": "oxfmt ."
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7"
  },
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.1.0"
  }
}
