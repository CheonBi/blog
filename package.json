{
  "name": "cheonbi-blog",
  "version": "1.0.0",
  "private": true,
  "description": "CheonBi blog and research",
  "repository": {
    "url": "https://github.com/CheonBi/blog",
    "type": "git"
  },
  "license": "MIT",
  "author": "cheonbi <root@cheonbi.kr>",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev:research": "pnpm --filter research dev",
    "preview:research": "pnpm --filter research preview:offline",
    "build": "pnpm build:blog && pnpm build:research",
    "build:blog": "pnpm --filter blog build",
    "build:research": "pnpm --filter research build",
    "test:restoration": "node --test scripts/tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "check:content": "node scripts/check-content.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "lint": "oxlint --type-aware && rust-markdownlint && node apps/blog/scripts/check-markdown.mjs --quiet",
    "lint:fix": "oxlint --type-aware --fix && rust-markdownlint --fix",
    "prettier": "oxfmt --check .",
    "prettier:fix": "oxfmt ."
  },
  "devDependencies": {
    "@yceffort/rust-markdownlint": "^0.1.3",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "catalog:",
    "web-push": "^3.6.7"
  },
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.1.0"
  }
}
